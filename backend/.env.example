SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Gmail SMTP
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# Comma-separated. Add your deployed web/mobile-facing domain(s) here in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Stripe (only needed if you keep the web Stripe Checkout flow alongside mobile IAP)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# n8n webhooks -- called server-side only. Never expose these in a frontend/mobile build.
DANIEL_WEBHOOK_URL=your_daniel_chat_webhook_url_here
ONBOARDING_WEBHOOK_URL=your_onboarding_sync_webhook_url_here
ANALYSIS_WEBHOOK_URL=your_analysis_webhook_url_here
DAILY_ACTION_WEBHOOK_URL=your_daily_action_webhook_url_here

# Production Security (keep False for local development)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
